# Secret references read by v1/bin/cards-auth.py (never the secrets themselves).
# Live copy: ~/.config/cards/onepassword.conf, mode 0600, outside the agent sandbox.
CHASE_USERNAME_REF=op://<vault>/<item>/<field>
CHASE_PASSWORD_REF=op://<vault>/<item>/<field>
CHASE_OTP_REF=
AMEX_USERNAME_REF=op://<vault>/<item>/<field>
AMEX_PASSWORD_REF=op://<vault>/<item>/<field>
AMEX_OTP_REF=
